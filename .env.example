
# ─── Razorpay Test-Mode Credentials ──────────────────────────────────────────
# Never commit the real .env file. Copy this to .env and fill in your values.
# Get these from: https://dashboard.razorpay.com → Settings → API Keys (Test Mode)

RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXX
RAZORPAY_KEY_SECRET=your_test_secret_here

# Webhook secret — set this in Dashboard → Settings → Webhooks
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Agent
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ─── Flask Config ─────────────────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=true

# ─── Paths ────────────────────────────────────────────────────────────────────
CAPTURED_WEBHOOKS_DIR=data/captured_webhooks
SYNTHETIC_BATCH_PATH=data/synthetic_batch.json
